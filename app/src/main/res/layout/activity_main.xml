<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera -->
        <TextView
            android:id="@+id/tvTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_recetario"
            android:textColor="@color/color_primario"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo_bienvenida"
            android:textColor="@color/color_texto_secundario"
            android:textSize="14sp" />

        <!-- Tarjeta de receta principal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/color_superficie_tarjeta"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Imagen mapa de bits de la receta -->
                <ImageView
                    android:id="@+id/imgReceta"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:contentDescription="@string/receta_ejemplo_nombre"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_salmon" />

                <!-- Título del plato -->
                <TextView
                    android:id="@+id/tvNombreReceta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/receta_ejemplo_nombre"
                    android:textColor="@color/color_texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Metadatos con icono vectorial -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/receta_ejemplo_tiempo"
                        android:src="@drawable/ic_receta_vector"
                        app:tint="@color/color_primario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/receta_ejemplo_tiempo"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/receta_ejemplo_dificultad"
                        android:textColor="@color/color_acento_destacado"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sección: Ingredientes -->
                <TextView
                    style="@style/EstiloTituloSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_ingredientes" />

                <TextView
                    style="@style/EstiloCuerpoReceta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texto_ingredientes" />

                <!-- Sección: Preparación -->
                <TextView
                    style="@style/EstiloTituloSeccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_preparacion" />

                <TextView
                    style="@style/EstiloCuerpoReceta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texto_preparacion" />

                <!-- Botón de acción con estilo propio -->
                <Button
                    android:id="@+id/btnNuevaReceta"
                    style="@style/EstiloBotonAccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/boton_anadir_receta" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>